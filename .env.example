# ============================================================
# Groq Whisper API（文字起こし・話者分離なし）- 無料枠あり・超高速
# https://console.groq.com/ で取得（個人メールOK）
# ============================================================
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Whisper モデル（whisper-large-v3 推奨）
# 選択肢: whisper-large-v3, whisper-large-v3-turbo
GROQ_WHISPER_MODEL=whisper-large-v3

# ============================================================
# AssemblyAI API（話者分離あり文字起こし）- $50無料クレジット
# https://www.assemblyai.com/ でサインアップ（個人メールOK）
# 話者分離ONのときだけ使用。OFFなら不要。
# ============================================================
ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Anthropic Claude API（要約・タスク抽出）
# https://console.anthropic.com/settings/keys で取得
# ============================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
